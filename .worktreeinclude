# Files matching these patterns are copied from the main repo into new worktrees.
# Uses gitignore syntax: globs, directory patterns, ! for negation.
# See: https://git-scm.com/docs/gitignore#_pattern_format

# .NET config
appsettings.Development.json
appsettings.Local.json
*.user

# Typescript config
.env*
!.env.template

# Demo sites
demos/v17/
*.local.slnx

# Local Claude/agent config (workflow rules + local settings) — without this,
# a worktree session never sees the mandatory worktree-workflow rules in
# CLAUDE.local.md, since that file isn't tracked in git
CLAUDE.local.md
.claude/settings.local.json

# Exclude non-source directories that contain pattern matches
!refs/**
!node_modules/**
!.worktrees/**