<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Global packages (SourceLink, NBGV, Umbraco.Code) -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.8.118" />
    <GlobalPackageReference Include="Umbraco.Code" Version="3.0.0-beta" />
    <GlobalPackageReference Include="Umbraco.GitVersioning.Extensions" Version="0.2.0" />
    <GlobalPackageReference Include="Umbraco.JsonSchema.Extensions" Version="0.3.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Umbraco CMS -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.5.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[17.5.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[17.5.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.5.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[17.5.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="[17.5.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="[17.5.0, 17.999.999)" />
  </ItemGroup>

  <!-- Umbraco Deploy -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Deploy.Infrastructure" Version="[17.0.2, 17.999.999)" />
  </ItemGroup>

  <!-- Umbraco Automate -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Automate.Core" Version="[17.0.0, 17.999.999)" />
  </ItemGroup>

  <!-- Umbraco Search -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.Search.Core" Version="[17.0.0, 17.999.999)" />
  </ItemGroup>

  <!-- Microsoft.Extensions.AI -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI" Version="[10.7.0, 10.999.999)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="[10.0.9, 10.999.999)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="[10.0.9, 10.999.999)" />
    <!-- Base library for typed SDK exceptions (ClientResultException). Used by Core's provider
         error classifier and brought in transitively by the OpenAI SDK. Floor matches the
         minimum version that exposes ClientResultException publicly. -->
    <PackageVersion Include="System.ClientModel" Version="[1.5.0, 1.999.999)" />
  </ItemGroup>

  <!-- Inter-product dependencies (version ranges for NuGet packages) -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.AI.Core" Version="[17.4.0-rc.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Web" Version="[17.4.0-rc.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.AGUI" Version="[17.2.0-rc.2, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Startup" Version="[17.4.0-rc.1, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="[17.2.0-rc.2, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent.Core" Version="[17.2.0-rc.2, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent.Startup" Version="[17.2.0-rc.2, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent.UI" Version="[17.1.0-rc.2, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot" Version="[17.1.0-rc.2, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Deploy" Version="[17.1.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Automate" Version="[17.0.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.AI.Prompt.Startup" Version="[17.2.2, 17.999.999)" />
  </ItemGroup>

  <!-- Microsoft AI Agent packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI" Version="[1.10.0, 1.999.999)" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="[1.10.0, 1.999.999)" />
  </ItemGroup>

  <!-- Provider packages -->
  <ItemGroup>
    <PackageVersion Include="Anthropic" Version="[12.29.1, 12.999.999)" />
    <PackageVersion Include="AWSSDK.Bedrock" Version="[4.0.30.4, 4.999.999)" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="[4.0.21.1, 4.999.999)" />
    <PackageVersion Include="AWSSDK.Extensions.Bedrock.MEAI" Version="[4.0.8.12, 4.999.999)" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="[2.1.0, 2.999.999)" />
    <PackageVersion Include="Azure.Identity" Version="[1.21.0, 1.999.999)" />
    <PackageVersion Include="Google.GenAI" Version="[1.10.0, 1.999.999)" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="[10.7.0, 10.999.999)" />
    <PackageVersion Include="Mistral.SDK" Version="[2.3.1, 2.999.999)" />
  </ItemGroup>

  <!-- Shared dependencies -->
  <ItemGroup>
    <PackageVersion Include="DocumentFormat.OpenXml" Version="[3.5.1, 3.999.999)" />
    <!-- 10.0.6 floor matches the EF Core version Umbraco.Cms 17.5.0 bundles. Bumping above
         the host CMS's transitive EF Core means our migrations DLLs reference assemblies the
         hosting app never resolves, and runtime fails with a TypeLoadException. Move this floor
         in lockstep with the host CMS, not ahead of it. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.6, 10.999.999)" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="[3.1.12, 3.999.999)" />
    <!-- 0.11.1 floor: 0.11.0 pulls AngleSharp 1.4.0, which is vulnerable to mXSS
         (GHSA-pgww-w46g-26qg, patched in 1.5.0). 0.11.1 depends on AngleSharp 1.5.2. -->
    <PackageVersion Include="SmartReader" Version="[0.11.1, 0.999.999)" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="[10.0.7, 10.999.999)" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
