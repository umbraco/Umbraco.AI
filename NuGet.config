<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- nuget.org: catch-all + stable Umbraco releases. Automate is mapped here too:
         its betas (e.g. Umbraco.Automate.Core 17.0.0-beta.1) now ship to nuget.org, and
         nightly prunes old prereleases, so nuget.org must be a considered source. Both
         nuget.org and Nightly carry the Automate patterns so NuGet picks the best in-range
         version across feeds. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
    <!-- Umbraco Nightly: Automate preview builds (kept for pre-release consumption). -->
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
