<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- nuget.org: catch-all + stable Umbraco releases. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
    </packageSource>
    <!-- Umbraco Prereleases: official beta/rc builds (Automate prerelease milestones,
         Deploy). Patterns are intentionally specific (Umbraco.Automate*, Umbraco.Deploy*)
         rather than the broader Umbraco.* — when a package ID matches a pattern in more than
         one source, NuGet resolves from the source with the longest matching pattern, and
         MyGet has been observed republishing the same prerelease version with different bytes
         (e.g. Umbraco.Code 3.0.0-beta), breaking lockfile contentHash validation in CI. By
         scoping this source to only the package families that genuinely live here, generic
         packages like Umbraco.Code that are also published to nuget.org always resolve from
         the immutable nuget.org tarball.

         NOTE: Umbraco.Cms* is intentionally NOT mapped here. CMS 18 shipped stable to
         nuget.org, and the monorepo now pins stable CMS ranges ([18.0.0, 18.999.999)). The
         MyGet prerelease feed does not mirror every stable CMS patch (e.g. it went
         18.0.0-rc4 → 18.0.1, skipping 18.0.0). Because Umbraco.Cms.* was a longer match than
         nuget.org's Umbraco.*, source mapping resolved CMS *exclusively* from MyGet and
         restore failed with NU1102 for the pinned 18.0.0. Leaving Umbraco.Cms* to fall through
         to nuget.org's Umbraco.* pattern lets stable CMS resolve from the immutable feed.
         Re-add Umbraco.Cms / Umbraco.Cms.* here only if the repo ever pins a CMS prerelease
         that lives solely on MyGet. -->
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
      <package pattern="Umbraco.Deploy" />
      <package pattern="Umbraco.Deploy.*" />
    </packageSource>
    <!-- Umbraco Nightly: continuous nightly Automate builds. -->
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
