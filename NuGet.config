<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- nuget.org: catch-all + stable Umbraco releases -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
    </packageSource>
    <!-- Umbraco Nightly: only packages that exist solely on the nightly feed (Automate previews) -->
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
