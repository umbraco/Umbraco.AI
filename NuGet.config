<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- nuget.org: catch-all + stable Umbraco releases. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Umbraco" />
      <package pattern="Umbraco.*" />
    </packageSource>
    <!-- Umbraco Prereleases: official beta/rc builds (Umbraco.Cms 18 RCs before stable,
         Automate prerelease milestones). Patterns are intentionally specific (Umbraco.Cms*,
         Umbraco.Automate*) rather than the broader Umbraco.* — when a package ID matches a
         pattern in more than one source, NuGet may resolve from either, and MyGet has been
         observed republishing the same prerelease versionwith different bytes (e.g.
         Umbraco.Code 3.0.0-beta), breaking lockfile contentHash validation in CI. By scoping
         this source to only the package families that genuinely live here, generic packages
         like Umbraco.Code that are also published to nuget.org always resolve from the
         immutable nuget.org tarball. -->
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco.Cms" />
      <package pattern="Umbraco.Cms.*" />
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
      <package pattern="Umbraco.Deploy" />
      <package pattern="Umbraco.Deploy.*" />
    </packageSource>
    <!-- Umbraco Nightly: continuous nightly Automate builds. -->
    <packageSource key="Umbraco Nightly">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
