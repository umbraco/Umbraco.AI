<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Inherit the central package versions from the root Directory.Packages.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <!-- Floor for the internal contracts shared with Umbraco.AI.Agent via InternalsVisibleTo:
         IAIAgentUnrestrictedReader and the allowed-user-groups mapping on AIAgent. Do not lower it
         below the Umbraco.AI.Agent version that ships granular permissions. -->
    <PackageVersion Update="Umbraco.AI.Agent.Startup" Version="[18.4.5, 18.999.999)" />
  </ItemGroup>
</Project>
