<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Inherit the central package versions from the root Directory.Packages.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <!-- 17.7.0 is the first Umbraco.AI release with the Extraction capability (AICapability.Extraction and
         AISettings.DefaultExtractionProfileId), which the settings connector carries. -->
    <PackageVersion Update="Umbraco.AI.Startup" Version="[17.7.0, 17.999.999)" />
  </ItemGroup>
</Project>
