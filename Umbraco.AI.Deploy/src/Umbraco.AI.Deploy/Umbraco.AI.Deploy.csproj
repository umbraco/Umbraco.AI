<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Title>Umbraco AI Deploy</Title>
    <Description>Umbraco Deploy support for Umbraco.AI</Description>
  </PropertyGroup>

  <!-- Use project references for local dev, NuGet packages for CI -->
  <PropertyGroup>
    <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\Umbraco.AI\src\Umbraco.AI.Startup\Umbraco.AI.Startup.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
    <PackageReference Include="Umbraco.AI.Startup" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Deploy.Infrastructure" />
    <!-- Temporary: Deploy 19.0.0-beta1 floors Umbraco.Cms.Api.Common at beta1, which restore
         picks over the rc1 the CMS needs (NU1605). Remove once Deploy ships a 19 rc. -->
    <PackageReference Include="Umbraco.Cms.Api.Common" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Umbraco.AI.Deploy.Tests.Unit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
