<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Inherit the central package versions from the root Directory.Packages.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <!-- 17.4.0 is the first Umbraco.AI.Prompt release with the public AIPrompt(Guid id) constructor
         the service connector creates prompts with. -->
    <PackageVersion Update="Umbraco.AI.Prompt.Startup" Version="[17.4.0, 17.999.999)" />
  </ItemGroup>
</Project>
