{
    "name": "@umbraco-ai/prompt",
    "version": "17.0.0",
    "type": "module",
    "scripts": {
        "watch": "tsc && vite build --watch",
        "build": "tsc -p tsconfig.json && vite build",
        "build:app": "tsc -p tsconfig.app.json && vite build",
        "generate-client": "node --no-warnings ../../../../scripts/build/generate-openapi.js ai-prompt-management"
    },
    "dependencies": {
        "@umbraco-ai/core": "*",
        "@umbraco-cms/backoffice": "^18.0.0"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "^0.97.0",
        "@umbraco-ui/uui": "^2.0.0-rc.2",
        "chalk": "^5.6.0",
        "cross-env": "^10.0.0",
        "typescript": "^5.9.2",
        "vite": "^8.0.16"
    }
}
