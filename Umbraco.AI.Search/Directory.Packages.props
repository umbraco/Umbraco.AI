<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Inherit the central package versions from the root Directory.Packages.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <!-- Kept level with the root Umbraco.AI floor, so Search builds against the same Core as the rest. -->
    <PackageVersion Update="Umbraco.AI.Core" Version="[17.8.3, 17.999.999)" />
    <PackageVersion Update="Umbraco.AI.Startup" Version="[17.8.3, 17.999.999)" />
  </ItemGroup>
</Project>
