<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Inherit the central package versions from the root Directory.Packages.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove(Directory.Packages.props, $(MSBuildThisFileDirectory)..))" />

  <ItemGroup>
    <!-- Search needs IUmbracoReadAuthorizer (first shipped in Umbraco.AI 18.6.1), which semantic_search
         uses to limit results to what the acting user can access. Every 19.x release has it, so this
         matches the root floor; keep it here so the reason stays next to the range. -->
    <PackageVersion Update="Umbraco.AI.Core" Version="[19.0.0-rc.1, 19.999.999)" />
    <PackageVersion Update="Umbraco.AI.Startup" Version="[19.0.0-rc.1, 19.999.999)" />
  </ItemGroup>
</Project>
