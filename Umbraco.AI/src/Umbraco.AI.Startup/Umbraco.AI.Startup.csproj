<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Title>Umbraco AI Startup</Title>
        <Description>Contains startup logic for Umbraco AI</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Umbraco.Cms.Core" />
        <PackageReference Include="Umbraco.Cms.Web.Common" />
    </ItemGroup>


    <PropertyGroup>
        <UseProjectReferences Condition="'$(UseProjectReferences)' == ''">true</UseProjectReferences>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
        <ProjectReference Include="..\Umbraco.AI.Core\Umbraco.AI.Core.csproj" />
        <ProjectReference Include="..\Umbraco.AI.Persistence\Umbraco.AI.Persistence.csproj" />
        <ProjectReference Include="..\Umbraco.AI.Persistence.SqlServer\Umbraco.AI.Persistence.SqlServer.csproj" />
        <ProjectReference Include="..\Umbraco.AI.Persistence.Sqlite\Umbraco.AI.Persistence.Sqlite.csproj" />
        <ProjectReference Include="..\Umbraco.AI.Web\Umbraco.AI.Web.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseProjectReferences)' != 'true'">
        <PackageReference Include="Umbraco.AI.Core" VersionOverride="[$(Version)]" />
        <PackageReference Include="Umbraco.AI.Persistence" VersionOverride="[$(Version)]" />
        <PackageReference Include="Umbraco.AI.Persistence.SqlServer" VersionOverride="[$(Version)]" />
        <PackageReference Include="Umbraco.AI.Persistence.Sqlite" VersionOverride="[$(Version)]" />
        <PackageReference Include="Umbraco.AI.Web" VersionOverride="[$(Version)]" />
    </ItemGroup>
</Project>
