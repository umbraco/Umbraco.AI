<Project>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <!-- Real Umbraco CMS, for the CMS document definition and its integration tests -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="[18.0.0,19)" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[18.0.0,19)" />
    <PackageVersion Include="Umbraco.Cms.Tests.Integration" Version="[18.0.0,19)" />
    <!-- Resolves NU1107 between Umbraco.Cms.Tests.Integration and its Roslyn dependencies -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
